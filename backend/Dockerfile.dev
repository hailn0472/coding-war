FROM node:20-alpine

# Install OpenSSL (required by Prisma) and Docker CLI (required by Judge service)
RUN apk add --no-cache openssl docker-cli

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Copy and set permissions for entrypoint script
COPY scripts/docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Expose port
EXPOSE 3000

# Use entrypoint to run migrations before starting
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["npm", "run", "dev"]
